{
	"info": {
		"name": "Smart Campus Operations Hub API",
		"description": "API collection for Resources, Bookings, Tickets, and Notifications.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Resources",
			"item": [
				{
					"name": "List Resources",
					"request": {
						"method": "GET",
						"header": [],
						"url": "http://localhost:8080/api/v1/resources?type=LAB&capacity=20"
					}
				},
				{
					"name": "Get Resource Detail",
					"request": {
						"method": "GET",
						"url": "http://localhost:8080/api/v1/resources/{{resource_id}}"
					}
				},
				{
					"name": "Create Resource (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Smart Lab 01\",\n  \"type\": \"LAB\",\n  \"capacity\": 30,\n  \"location\": \"Building A, Floor 2\",\n  \"description\": \"Advanced computing lab\",\n  \"status\": \"ACTIVE\",\n  \"availabilityWindows\": [\n    {\n      \"dayOfWeek\": \"MONDAY\",\n      \"startTime\": \"08:00:00\",\n      \"endTime\": \"17:00:00\"\n    }\n  ]\n}"
						},
						"url": "http://localhost:8080/api/v1/resources"
					}
				},
				{
					"name": "Update Resource (Admin)",
					"request": {
						"method": "PUT",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Smart Lab 01 Updated\",\n  \"type\": \"LAB\",\n  \"capacity\": 35,\n  \"location\": \"Building A, Floor 2\",\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": "http://localhost:8080/api/v1/resources/{{resource_id}}"
					}
				},
				{
					"name": "Delete Resource (Admin)",
					"request": {
						"method": "DELETE",
						"header": [
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"url": "http://localhost:8080/api/v1/resources/{{resource_id}}"
					}
				}
			]
		},
		{
			"name": "Bookings",
			"item": [
				{
					"name": "Create Booking",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resourceId\": \"{{resource_id}}\",\n  \"startDateTime\": \"2026-05-01T10:00:00\",\n  \"endDateTime\": \"2026-05-01T12:00:00\",\n  \"purpose\": \"Workshop on AI\",\n  \"expectedAttendees\": 15\n}"
						},
						"url": "http://localhost:8080/api/v1/bookings"
					}
				},
				{
					"name": "Get Booking Detail",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"url": "http://localhost:8080/api/v1/bookings/{{booking_id}}"
					}
				},
				{
					"name": "Approve Booking (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Approved for the workshop.\"\n}"
						},
						"url": "http://localhost:8080/api/v1/bookings/{{booking_id}}/approve"
					}
				},
				{
					"name": "Reject Booking (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"note\": \"Resource unavailable at this time.\"\n}"
						},
						"url": "http://localhost:8080/api/v1/bookings/{{booking_id}}/reject"
					}
				},
				{
					"name": "Cancel Booking (Owner)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"url": "http://localhost:8080/api/v1/bookings/{{booking_id}}/cancel"
					}
				}
			]
		},
		{
			"name": "Incident Tickets",
			"item": [
				{
					"name": "Report Incident",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"resourceId\": \"{{resource_id}}\",\n  \"location\": \"Lab 01\",\n  \"category\": \"IT\",\n  \"description\": \"Projector not working\",\n  \"priority\": \"HIGH\"\n}"
						},
						"url": "http://localhost:8080/api/v1/tickets"
					}
				},
				{
					"name": "Assign Technician (Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Role", "value": "ADMIN"}
						],
						"url": "http://localhost:8080/api/v1/tickets/{{ticket_id}}/assign?technicianId={{tech_id}}"
					}
				},
				{
					"name": "Update Status (Tech)",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Role", "value": "TECHNICIAN"}
						],
						"url": "http://localhost:8080/api/v1/tickets/{{ticket_id}}/status?status=RESOLVED&notes=Fixed connection cable"
					}
				},
				{
					"name": "Add Attachment (Owner)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{"key": "file", "type": "file", "src": []}
							]
						},
						"url": "http://localhost:8080/api/v1/tickets/{{ticket_id}}/attachments"
					}
				},
				{
					"name": "Add Comment",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"I have checked the cables, they seem fine.\"\n}"
						},
						"url": "http://localhost:8080/api/v1/tickets/{{ticket_id}}/comments"
					}
				}
			]
		},
		{
			"name": "Notifications",
			"item": [
				{
					"name": "Get My Notifications",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"url": "http://localhost:8080/api/v1/notifications"
					}
				},
				{
					"name": "Mark as Read",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"}
						],
						"url": "http://localhost:8080/api/v1/notifications/{{notif_id}}/read"
					}
				},
				{
					"name": "Mark All as Read",
					"request": {
						"method": "PATCH",
						"header": [
							{"key": "Authorization", "value": "Bearer {{jwt_token}}"},
							{"key": "X-User-Id", "value": "{{user_id}}"}
						],
						"url": "http://localhost:8080/api/v1/notifications/read-all"
					}
				}
			]
		}
	]
}
